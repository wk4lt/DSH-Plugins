{
  "name": "@wk4lt/dsh-software-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Four software development modes with project-level acceptance handoff.",
  "exports": {
    ".": "./index.js",
    "./mcp-policy": "./mcp-policy.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "mcp-policy.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
