{
  "name": "@wk4lt/dsh-software-workflow",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Markdown-defined DSH agents with per-mode tools, MCP servers, and acceptance handoff.",
  "exports": {
    ".": "./index.js",
    "./mcp-policy": "./mcp-policy.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "agent-files.js", "agent-presets.js", "mcp-policy.js", "client.js", "cordis.patch.yml", "agents", "examples", "locale/*.json", "icon.svg"],
  "dsh": {
    "engines": { "dsh": ">=0.2.2-rc.1 <0.3.0" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-agent-preset"]
    }
  },
  "dependencies": { "zod": "^4.4.3", "yaml": "^2.8.1" },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.1.0", "@deepseek-ai/dsh-agent-preset": ">=0.2.2-rc.1 <0.3.0" },
  "devDependencies": { "@deepseek-ai/cordis": "^4.1.0", "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1", "@deepseek-ai/dsh-session": "0.2.2-rc.1", "react": "^18.3.1", "react-test-renderer": "^18.3.1" },
  "scripts": { "test": "node --test test/*.test.js" }
}
